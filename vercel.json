{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/admin-page.js": {
      "includeFiles": "{admin/**,server/session-key.private}"
    },
    "api/admin-auth.js": {
      "includeFiles": "server/session-key.private"
    }
  },
  "routes": [
    { "src": "^/admin(?:/(.*))?$", "dest": "/api/admin-page?file=$1" },
    { "handle": "filesystem" }
  ]
}
