{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "functions": {
    "api/admin-page.js": {
      "includeFiles": "admin/**"
    }
  },
  "routes": [
    { "src": "^/admin(?:/(.*))?$", "dest": "/api/admin-page?file=$1" },
    { "handle": "filesystem" }
  ]
}
